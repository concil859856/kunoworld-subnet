# KunoWorld TDX guest kernel: merged over x86_64_defconfig by mkosi/mkosi.build. What the measured
# chain and the worker need is built in (no initrd modules); introspection the host could use is off.

CONFIG_LOCALVERSION="-kuno"
# CONFIG_LOCALVERSION_AUTO is not set

# TDX guest, quotes (configfs-tsm) and writable RTMRs (sysfs, Linux >= 6.16)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_INTEL_TDX_GUEST=y
CONFIG_UNACCEPTED_MEMORY=y
CONFIG_VIRT_DRIVERS=y
CONFIG_TDX_GUEST_DRIVER=y
CONFIG_TSM_REPORTS=y
CONFIG_TSM_MEASUREMENTS=y
CONFIG_CONFIGFS_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Boot: virtio disks and network, dm-verity squashfs root, fw_cfg for host settings
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_FW_CFG_SYSFS=y

# Containers
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# GPUs (NVIDIA open modules are built out of tree against this kernel)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_MODULES=y
# CONFIG_MODULE_SIG is not set

# Reproducible and closed to the host
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_IKHEADERS is not set
# CONFIG_IKCONFIG is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_HOTPLUG_PCI is not set
