{
  "version": 1,
  "note": "Weight precision recipes for the resident LTX-2.5 backend, diffusers layout (Lightricks/LTX-2.5-Diffusers). Memory figures are GiB estimates (measured: false) until worker/scripts/benchmark_ltx_quantized.py measures them on the class; they are not part of the weights digest. No per-file SHA-256 is pinned: LTX-2.5 is gated and Hugging Face shows none (checked 2026-09-14), so the owner publishes kuno-devkit weights-digest output in the manifest instead.",
  "recipes": [
    {
      "id": "ltx-2.5-distilled/bf16/1",
      "family": "ltx-2.5",
      "variants": ["fast"],
      "precision": "bf16",
      "runtime": "diffusers-ltx2/1",
      "transformer_subfolder": "transformer",
      "include": ["model_index.json", "scheduler", "tokenizer", "text_encoder", "connectors", "transformer", "vae", "audio_vae", "vocoder", "latent_upsampler", "prompt_enhancer"],
      "components": {
        "transformer": {"method": "none"},
        "text_encoder": {"method": "none"}
      },
      "packages": {"diffusers": ">=0.40.0", "torch": ">=2.7"},
      "memory": {
        "components_gib": {"transformer": 39.13, "text_encoder": 22.4, "prompt_enhancer": 8.0, "other": 2.64},
        "group_onload_gib": 1.7,
        "activation_fixed_gib": 2.0,
        "activation_gib_per_10k_tokens": 1.6,
        "overhead_gib": 1.5,
        "measured": false,
        "basis": "transformer: ltx-2.5-22b-distilled-transformer-bf16.safetensors is 42,018,190,584 bytes (HF tree); text encoder: 12B parameters x 2 bytes; other: 22.67 - 20.03 GiB (runaihome, 4090); activations fitted to 'int8-convrot maxes out around 10 s at 720p, 15 s OOM' on a 5090 (note.com); prompt enhancer: unknown, 8 GiB assumed"
      },
      "sources": [
        "https://huggingface.co/Lightricks/LTX-2.5",
        "https://huggingface.co/docs/diffusers/main/en/api/pipelines/ltx2",
        "https://github.com/huggingface/diffusers/releases/tag/v0.40.0",
        "https://runaihome.com/blog/ltx-2-5-local-ai-video-hardware-guide-2026/",
        "https://note.com/truenorthai/n/nf600b6190507"
      ]
    },
    {
      "id": "ltx-2.5-dev/bf16/1",
      "family": "ltx-2.5",
      "variants": ["pro"],
      "precision": "bf16",
      "runtime": "diffusers-ltx2/1",
      "transformer_subfolder": "transformer_full",
      "include": ["model_index.json", "scheduler", "tokenizer", "text_encoder", "connectors", "transformer_full", "vae", "audio_vae", "vocoder", "latent_upsampler", "prompt_enhancer"],
      "components": {
        "transformer": {"method": "none"},
        "text_encoder": {"method": "none"}
      },
      "packages": {"diffusers": ">=0.40.0", "torch": ">=2.7"},
      "memory": {
        "components_gib": {"transformer": 39.13, "text_encoder": 22.4, "prompt_enhancer": 8.0, "other": 2.64},
        "group_onload_gib": 1.7,
        "activation_fixed_gib": 2.0,
        "activation_gib_per_10k_tokens": 3.2,
        "overhead_gib": 1.5,
        "measured": false,
        "basis": "as the distilled bf16 recipe; activations doubled for classifier-free guidance (batch of two)"
      },
      "sources": [
        "https://huggingface.co/Lightricks/LTX-2.5",
        "https://huggingface.co/docs/diffusers/main/en/api/pipelines/ltx2"
      ]
    },
    {
      "id": "ltx-2.5-dfr/bf16/1",
      "family": "ltx-2.5",
      "variants": ["dfr"],
      "precision": "bf16",
      "runtime": "diffusers-ltx2/1",
      "transformer_subfolder": "transformer",
      "include": ["model_index.json", "scheduler", "tokenizer", "text_encoder", "connectors", "transformer", "vae", "audio_vae", "vocoder", "latent_upsampler", "temporal_latent_upsampler", "diffusion_decoder", "prompt_enhancer"],
      "components": {
        "transformer": {"method": "none"},
        "text_encoder": {"method": "none"}
      },
      "packages": {"diffusers": ">=0.40.0", "torch": ">=2.7"},
      "memory": {
        "components_gib": {"transformer": 39.13, "text_encoder": 22.4, "prompt_enhancer": 8.0, "other": 6.0},
        "group_onload_gib": 1.7,
        "activation_fixed_gib": 8.0,
        "activation_gib_per_10k_tokens": 1.6,
        "overhead_gib": 1.5,
        "measured": false,
        "basis": "as the distilled bf16 recipe, plus the temporal upsampler and diffusion decoder (sizes unknown); 4K decode is the peak"
      },
      "sources": [
        "https://huggingface.co/Lightricks/LTX-2.5"
      ]
    },
    {
      "id": "ltx-2.5-distilled/fp8-cast/1",
      "family": "ltx-2.5",
      "variants": ["fast"],
      "precision": "fp8-cast",
      "runtime": "diffusers-ltx2/1",
      "transformer_subfolder": "transformer",
      "include": ["model_index.json", "scheduler", "tokenizer", "text_encoder", "connectors", "transformer", "vae", "audio_vae", "vocoder", "latent_upsampler", "prompt_enhancer"],
      "components": {
        "transformer": {
          "method": "layerwise-cast",
          "storage_dtype": "float8_e4m3fn",
          "compute_dtype": "bfloat16",
          "skip_modules_pattern": ["pos_embed", "patch_embed", "norm", "^proj_in$", "^proj_out$"]
        },
        "text_encoder": {"method": "none"}
      },
      "packages": {"diffusers": ">=0.40.0", "torch": ">=2.7"},
      "memory": {
        "components_gib": {"transformer": 20.03, "text_encoder": 22.4, "prompt_enhancer": 8.0, "other": 2.64},
        "group_onload_gib": 1.0,
        "activation_fixed_gib": 2.0,
        "activation_gib_per_10k_tokens": 1.6,
        "overhead_gib": 1.5,
        "measured": false,
        "basis": "transformer assumed equal to the 8-bit int8-convrot build's measured 20.03 GiB resident (runaihome); SGLang documents 18.11 GB for its FP8 LTX-2.5 transformer. Text encoder stays bf16 and is offloaded while the transformer runs."
      },
      "sources": [
        "https://github.com/Lightricks/LTX-2/tree/main/packages/ltx-core/src/ltx_core/quantization",
        "https://github.com/Lightricks/LTX-2/blob/main/packages/ltx-pipelines/docs/optimization.md",
        "https://huggingface.co/docs/diffusers/main/en/optimization/memory",
        "https://github.com/huggingface/diffusers/releases/tag/v0.33.0",
        "https://runaihome.com/blog/ltx-2-5-local-ai-video-hardware-guide-2026/"
      ]
    },
    {
      "id": "ltx-2.5-distilled/int8-wo/1",
      "family": "ltx-2.5",
      "variants": ["fast"],
      "precision": "int8-wo",
      "runtime": "diffusers-ltx2/1",
      "transformer_subfolder": "transformer",
      "include": ["model_index.json", "scheduler", "tokenizer", "text_encoder", "connectors", "transformer", "vae", "audio_vae", "vocoder", "latent_upsampler", "prompt_enhancer"],
      "components": {
        "transformer": {
          "method": "torchao",
          "storage_dtype": "int8",
          "compute_dtype": "bfloat16",
          "torchao_config": "Int8WeightOnlyConfig",
          "torchao_kwargs": {"group_size": 128, "version": 2}
        },
        "text_encoder": {
          "method": "torchao",
          "storage_dtype": "int8",
          "compute_dtype": "bfloat16",
          "torchao_config": "Int8WeightOnlyConfig",
          "torchao_kwargs": {"group_size": 128, "version": 2}
        }
      },
      "packages": {"diffusers": ">=0.40.0", "torchao": ">=0.15.0", "transformers": ">=4.51", "torch": ">=2.7"},
      "memory": {
        "components_gib": {"transformer": 20.35, "text_encoder": 11.4, "prompt_enhancer": 8.0, "other": 2.64},
        "group_onload_gib": 1.0,
        "activation_fixed_gib": 2.0,
        "activation_gib_per_10k_tokens": 1.6,
        "overhead_gib": 1.5,
        "measured": false,
        "basis": "int8 weights + one bf16 scale per 128 weights (x 1.016) over the 20.03 GiB 8-bit transformer; text encoder 12B x 1 byte. Lightricks' comfy-int8-convrot file is ComfyUI-only, so this class quantizes the bf16 checkpoint with torchao at load."
      },
      "sources": [
        "https://huggingface.co/docs/diffusers/main/en/quantization/torchao",
        "https://github.com/huggingface/diffusers/blob/main/src/diffusers/quantizers/quantization_config.py",
        "https://huggingface.co/Lightricks/LTX-2.5",
        "https://runaihome.com/blog/ltx-2-5-local-ai-video-hardware-guide-2026/"
      ]
    }
  ]
}
